DATASET_SPLIT=test
DATASET_REVISION=main

SLM_MODEL_ID=Qwen/Qwen3.5-2B
SOLVER_MODEL_ID=Qwen/Qwen3.5-2B
ZVENO_BASE_URL=https://api.zveno.ai/v1
