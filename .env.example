RESULTS_DIR=results
HF_CACHE_DIR=hf_cache
DATA_DIR=data

MAX_NEW_TOKENS=32
BATCH_SIZE=8
GENERATION_TEMPERATURE=0.8
GENERATION_BATCH_SIZE=4
PARAPHRASES_PER_TEXT=4

LENGTH_MARGIN=0.20
SCORE_MARGIN_DELTA=0.5
PAIRWISE_GAP_TAU=0.25
ANALYZE_MARGIN_SAMPLES=32

GRPO_GROUP_SIZE=4
GRPO_EPOCHS=1
GRPO_LEARNING_RATE=5e-6
GRPO_PER_DEVICE_BATCH_SIZE=1
